{% comment %}
  Section contract.
  Renders the "Tisso vison in the wild" product grid: a 3 x 2 desktop / 2 x 3
  mobile image grid with a circular quick-view hotspot on every card and a
  shared quick-view dialog.

  Each card owns its complete product data in a hidden container, so the dialog
  can render titles, prices, descriptions, images, and real option values
  without relying on `product | json` (which drops some fields).

  The dialog renders Color and Size controls from the product's real options.
  Choosing Black (or black) with M (or Medium) also adds the bonus product
  selected in the section settings.

  @example
  <!-- Add the section to a JSON template, assign products to its blocks, and
       optionally choose a bonus product for the Black + Medium rule. -->
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Lustria&display=swap"
  rel="stylesheet"
>

{% liquid
  assign bonus_product = section.settings.bonus_product
  assign bonus_variant = bonus_product.selected_or_first_available_variant
  assign cart_currency = cart.currency.iso_code | default: shop.currency
%}

<section
  id="CustomProductGrid-{{ section.id }}"
  class="cpg"
  data-custom-product-grid
  data-bonus-variant-id="{{ bonus_variant.id }}"
  data-bonus-available="{% if bonus_variant != blank and bonus_variant.available %}true{% else %}false{% endif %}"
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  data-cart-url="{{ routes.cart_url }}.js"
  data-money-format="{{ shop.money_format | strip_html | escape_once }}"
  data-currency="{{ cart_currency | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="cpg__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="cpg__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="cpg__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_product = block.settings.product
          assign hotspot_top = block.settings.hotspot_top | default: 50
          assign hotspot_left = block.settings.hotspot_left | default: 50
        -%}

        <li class="cpg__item" data-cpg-card {{ block.shopify_attributes }}>
          <div class="cpg-card">
            <div class="cpg-card__media">
              {%- if card_product != blank and card_product.featured_image != blank -%}
                {%- assign card_image_alt = card_product.featured_image.alt | default: card_product.title -%}
                {{
                  card_product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '300, 433, 600, 866, 1000, 1200',
                    sizes: '(min-width: 750px) 33vw, 50vw',
                    class: 'cpg-card__image',
                    loading: 'lazy',
                    alt: card_image_alt
                }}
              {%- elsif card_product != blank and card_product.featured_media.preview_image != blank -%}
                {%- assign card_image_alt = card_product.featured_media.preview_image.alt | default: card_product.title -%}
                {{
                  card_product.featured_media.preview_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '300, 433, 600, 866, 1000, 1200',
                    sizes: '(min-width: 750px) 33vw, 50vw',
                    class: 'cpg-card__image',
                    loading: 'lazy',
                    alt: card_image_alt
                }}
              {%- else -%}
                <div class="cpg-card__placeholder" aria-hidden="true">
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'cpg-card__placeholder-svg' }}
                </div>
              {%- endif -%}

              {%- if card_product != blank -%}
                <button
                  type="button"
                  class="cpg-card__hotspot"
                  style="top: {{ hotspot_top }}%; left: {{ hotspot_left }}%;"
                  data-cpg-hotspot
                  aria-label="Quick view: {{ card_product.title | escape }}"
                  aria-haspopup="dialog"
                  aria-controls="CpgDialog-{{ section.id }}"
                >
                  <svg
                    class="cpg-card__hotspot-icon"
                    viewBox="0 0 10 10"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M5 1V9M1 5H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </button>
              {%- endif -%}
            </div>

            {%- if card_product != blank -%}
              <div
                class="hidden-product-data"
                style="display: none;"
                data-variant-id="{{ block.settings.product.selected_or_first_available_variant.id }}"
                data-title="{{ block.settings.product.title | escape }}"
                data-price="{{ block.settings.product.price | money }}"
                data-image="{{ block.settings.product.featured_image | image_url: width: 800 }}"
                data-description="{{ block.settings.product.description | strip_html | truncatewords: 30 | escape }}"
              >
                <script type="application/json" class="product-options-json">
                  {{ block.settings.product.options_with_values | json }}
                </script>
                <script type="application/json" class="product-variants-json">
                  {{ block.settings.product.variants | json }}
                </script>
              </div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <dialog
    class="cpg-modal"
    id="CpgDialog-{{ section.id }}"
    aria-labelledby="CpgDialogTitle-{{ section.id }}"
    aria-describedby="CpgDialogDescription-{{ section.id }}"
    data-cpg-dialog
  >
    <button type="button" class="cpg-modal__close" data-cpg-close aria-label="Close quick view">
      <svg
        viewBox="0 0 12 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M1 1L11 11M1 11L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="cpg-modal__top">
      <div class="cpg-modal__media">
        <img
          class="cpg-modal__image"
          data-cpg-image
          width="120"
          height="140"
          alt=""
          loading="lazy"
          hidden
        >
      </div>

      <div class="cpg-modal__meta">
        <h3 class="cpg-modal__title" id="CpgDialogTitle-{{ section.id }}" data-cpg-title></h3>
        <p class="cpg-modal__price" data-cpg-price></p>
        <div class="cpg-modal__description" id="CpgDialogDescription-{{ section.id }}" data-cpg-description></div>
      </div>
    </div>

    <div class="cpg-modal__field" data-cpg-color-section hidden>
      <span class="cpg-modal__label" id="CpgColorLabel-{{ section.id }}">Color</span>
      <div
        class="cpg-colors"
        role="radiogroup"
        aria-labelledby="CpgColorLabel-{{ section.id }}"
        data-cpg-colors
      ></div>
    </div>

    <div class="cpg-modal__field" data-cpg-size-section hidden>
      <span class="cpg-modal__label" id="CpgSizeLabel-{{ section.id }}">Size</span>
      <div class="cpg-select" data-cpg-select>
        <button
          type="button"
          class="cpg-select__trigger"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="CpgSizeMenu-{{ section.id }}"
          aria-labelledby="CpgSizeLabel-{{ section.id }} CpgSizeValue-{{ section.id }}"
          data-cpg-size-trigger
        >
          <span class="cpg-select__value" id="CpgSizeValue-{{ section.id }}" data-cpg-size-value>Choose your size</span>
          <span class="cpg-select__icon" aria-hidden="true">
            <svg
              class="cpg-select__chevron"
              viewBox="0 0 12 6"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              focusable="false"
            >
              <path d="M1 1L6 5L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>

        <ul
          class="cpg-select__menu"
          id="CpgSizeMenu-{{ section.id }}"
          role="listbox"
          aria-labelledby="CpgSizeLabel-{{ section.id }}"
          tabindex="-1"
          data-cpg-size-menu
          hidden
        ></ul>
      </div>
    </div>

    <button type="button" class="cpg-modal__submit" data-cpg-submit>
      <span data-cpg-submit-text>ADD TO CART</span>
      <svg
        class="cpg-modal__submit-arrow"
        viewBox="0 0 34 8"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M0 4H32M32 4L27 1M32 4L27 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <p class="cpg-modal__notice" role="status" aria-live="polite" data-cpg-notice></p>
  </dialog>
</section>

{% stylesheet %}
  .cpg {
    --cpg-body-font: 'Jost', 'Helvetica Neue', Arial, sans-serif;
    --cpg-heading-font: 'Lustria', Georgia, 'Times New Roman', serif;
    --cpg-ink: #000000;
    --cpg-paper: #ffffff;
    --cpg-muted: #333333;
    --cpg-placeholder: #f5f5f5;
    --cpg-hotspot: rgb(248 248 248 / 0.9);
    --cpg-accent: #fff544;
    --cpg-error: #b20f36;
    --cpg-success: #1b5e20;
    --cpg-grid-gap: 20px;

    background-color: var(--cpg-paper);
    color: var(--cpg-ink);
    font-family: var(--cpg-body-font);
    -webkit-font-smoothing: antialiased;
  }

  .cpg *,
  .cpg *::before,
  .cpg *::after {
    box-sizing: border-box;
  }

  .cpg [hidden] {
    display: none !important;
  }

  .cpg__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 50px 80px;
  }

  .cpg__heading {
    margin: 0 0 30px;
    color: var(--cpg-ink);
    font-family: var(--cpg-heading-font);
    font-size: 36px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    text-align: left;
  }

  .cpg__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--cpg-grid-gap);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cpg__item {
    min-width: 0;
  }

  .cpg-card {
    position: relative;
    width: 100%;
    aspect-ratio: 433 / 444;
    overflow: hidden;
    background-color: var(--cpg-placeholder);
  }

  .cpg-card__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .cpg-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .cpg-card:hover .cpg-card__image {
      transform: scale(1.03);
    }
  }

  .cpg-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: #efefef;
    color: #999999;
  }

  .cpg-card__placeholder-svg {
    width: 45%;
    height: 45%;
    opacity: 0.55;
  }

  /* Circular hotspot (Figma: 22px desktop / 16px mobile, 90% white fill) */
  .cpg-card__hotspot {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin: 0;
    padding: 0;
    background-color: var(--cpg-hotspot);
    border: 1px solid rgb(0 0 0 / 0.1);
    border-radius: 50%;
    color: var(--cpg-ink);
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition:
      transform 0.2s cubic-bezier(0.25, 1, 0.5, 1),
      background-color 0.2s ease;
  }

  /* Restores a comfortable touch target without changing the visual size. */
  .cpg-card__hotspot::before {
    content: '';
    position: absolute;
    inset: -11px;
    border-radius: 50%;
  }

  .cpg-card__hotspot:hover {
    background-color: #ffffff;
    transform: translate(-50%, -50%) scale(1.15);
  }

  .cpg-card__hotspot:focus-visible {
    outline: 2px solid var(--cpg-ink);
    outline-offset: 3px;
  }

  .cpg-card__hotspot-icon {
    display: block;
    width: 9px;
    height: 9px;
    pointer-events: none;
  }

  /* Quick view dialog (Figma: 311px wide, 1px black border, square corners) */
  .cpg-modal {
    position: fixed;
    inset: 0;
    width: 311px;
    max-width: calc(100vw - 32px);
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 36px 20px 25px;
    overflow: visible;
    background-color: var(--cpg-paper);
    border: 1px solid var(--cpg-ink);
    border-radius: 0;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
    color: var(--cpg-ink);
    font-family: var(--cpg-body-font);
    opacity: 0;
    transform: translateY(16px) scale(0.97);
    transition:
      opacity 0.25s ease,
      transform 0.25s cubic-bezier(0.25, 1, 0.5, 1),
      display 0.25s allow-discrete,
      overlay 0.25s allow-discrete;
  }

  .cpg-modal[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @starting-style {
    .cpg-modal[open] {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }

  .cpg-modal::backdrop {
    background-color: rgb(0 0 0 / 0.45);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition:
      opacity 0.25s ease,
      display 0.25s allow-discrete,
      overlay 0.25s allow-discrete;
  }

  .cpg-modal[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .cpg-modal[open]::backdrop {
      opacity: 0;
    }
  }

  .cpg-modal__close {
    position: absolute;
    top: 11px;
    right: 10px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: var(--cpg-ink);
    cursor: pointer;
  }

  .cpg-modal__close svg {
    display: block;
    width: 12px;
    height: 12px;
  }

  .cpg-modal__close:hover {
    transform: scale(1.1);
  }

  .cpg-modal__close:focus-visible {
    outline: 2px solid var(--cpg-ink);
    outline-offset: 0;
  }

  .cpg-modal__top {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0 0 10px;
  }

  .cpg-modal__media {
    flex: 0 0 120px;
    width: 120px;
    height: 140px;
    overflow: hidden;
    background-color: #f7f7f7;
  }

  .cpg-modal__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cpg-modal__meta {
    flex: 1 1 auto;
    min-width: 0;
    padding-top: 13px;
    overflow: hidden;
  }

  .cpg-modal__title {
    margin: 0 0 22px;
    overflow: hidden;
    color: var(--cpg-ink);
    font-family: var(--cpg-body-font);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cpg-modal__price {
    margin: 0 0 13px;
    color: var(--cpg-ink);
    font-family: var(--cpg-heading-font);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
  }

  .cpg-modal__description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--cpg-ink);
    font-family: var(--cpg-body-font);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.1;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .cpg-modal__field {
    position: relative;
    width: 100%;
    margin: 0 0 11px;
  }

  .cpg-modal__label {
    display: flex;
    align-items: center;
    height: 18px;
    margin: 0 0 6.35px;
    color: #333333;
    font-family: var(--cpg-body-font, 'Jost', sans-serif);
    font-size: 14px;
    font-weight: 400;
    line-height: 130%;
    letter-spacing: 0;
    text-align: left;
  }

  /* ------------------------------------------------------------------
     Color options: unified locked flex container.

     Architecture: ONE frame border lives on the container. Swatch items
     carry zero borders and zero margins, so no per-item geometry can ever
     differ between swatches. Dividers and color strips are paint-only
     pseudo-elements clipped by a fixed-size box, so no sub-pixel border
     rounding or negative-margin overlap can shift a box.
     ------------------------------------------------------------------ */
  .cpg-colors,
  .color-swatches {
    display: flex;
    align-items: stretch;
    width: 100%;
    height: 40px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: var(--cpg-paper);
    border: 1px solid var(--cpg-ink);
    border-radius: 0;
  }

  /* Base swatch: hard geometry lock. The !important resets neutralize any
     global button/label CSS (UA or theme) trying to inject margins, borders,
     transforms, or shadows onto these elements. */
  .color-swatch,
  .cpg-color {
    position: relative;
    overflow: hidden;
    flex: 1 1 0;
    align-self: stretch;
    min-width: 0;
    height: 100%;
    margin: 0 !important;
    padding-block: 0;
    padding-inline: 17px 12px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    appearance: none;
    -webkit-appearance: none;
    background-color: var(--cpg-paper);
    border: 0 !important;
    border-radius: 0;
    box-shadow: none !important;
    transform: none !important;
    translate: none !important;
    scale: none !important;
    color: var(--cpg-ink);
    cursor: pointer;
    font-family: var(--cpg-body-font, 'Jost', sans-serif);
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    text-align: start;
    --swatch-color: var(--cpg-swatch, var(--cpg-ink));
  }

  /* Inter-box divider: integer 1px inline-start border. Only the inline
     axis is touched, so it can never change an item's height or vertical
     alignment. box-sizing:border-box keeps all items at equal widths.
     Padding is reduced by 1px so every label starts at the same offset. */
  .color-swatch + .color-swatch,
  .cpg-color + .cpg-color {
    padding-inline-start: 16px;
    border-inline-start: 1px solid var(--cpg-ink) !important;
  }

  /* Hairline after the color strip (Figma indicator stroke). Paint-only,
     applied to every item so each swatch reads identically. Logical
     inset so it mirrors with the strip in RTL. */
  .color-swatch::after,
  .cpg-color::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 6px;
    width: 1px;
    background-color: rgb(0 0 0 / 0.35);
    pointer-events: none;
  }

  /* Left color strip: paint-only, clipped flush by the item. Logical
     properties so the strip mirrors correctly in RTL. */
  .color-swatch::before,
  .cpg-color::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 6px;
    background-color: var(--swatch-color, var(--cpg-swatch, var(--cpg-ink)));
    pointer-events: none;
  }

  /* Swatch label */
  .color-swatch span,
  .color-swatch__label,
  .cpg-color__label {
    display: block;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Hover: cosmetic only — no geometry properties */
  .color-swatch:hover:not(.is-selected):not(.active):not(.selected),
  .cpg-color:hover:not(.is-selected):not(.active):not(.selected) {
    background-color: #f8f8f8;
  }

  /* Selected / Active: cosmetic only — zero geometry re-declarations. The
     margin/transform locks are restated defensively so no inherited rule
     can move the selected box against its neighbours. */
  .color-swatch.selected,
  .color-swatch.active,
  .color-swatch.is-selected,
  .cpg-color.selected,
  .cpg-color.active,
  .cpg-color.is-selected {
    margin: 0 !important;
    transform: none !important;
    background-color: var(--cpg-ink);
    color: #ffffff;
  }

  /* :active pseudo (mousedown moment): cosmetic only */
  .color-swatch:active,
  .cpg-color:active {
    background-color: var(--cpg-ink);
    color: #ffffff;
  }

  /* Hover on selected: keep black */
  .color-swatch.selected:hover,
  .color-swatch.active:hover,
  .color-swatch.is-selected:hover,
  .cpg-color.selected:hover,
  .cpg-color.active:hover,
  .cpg-color.is-selected:hover {
    background-color: var(--cpg-ink);
    color: #ffffff;
  }

  /* Override Dawn's global *:focus-visible ring (outline-offset: 0.2em
     paints OUTSIDE the box, which reads as a position shift against the
     neighbour). Draw the ring INSIDE the box instead: still clearly
     visible for keyboard users, physically unable to escape the swatch. */
  .color-swatch:focus,
  .color-swatch:focus-visible,
  .cpg-color:focus,
  .cpg-color:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: -3px;
  }

  /* Custom size dropdown (Component 213) */
  .cpg-select {
    position: relative;
    width: 100%;
    max-width: 271px;
    margin: 0;
    padding: 0;
  }

  .cpg-select__trigger {
    box-sizing: border-box;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    width: 100%;
    max-width: 271px;
    height: 40px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #ffffff;
    border: 1px solid #000000;
    border-radius: 0;
    color: #000000;
    cursor: pointer;
    font-family: var(--cpg-body-font, 'Jost', sans-serif);
    text-align: left;
    outline: none;
  }

  .cpg-select__value {
    box-sizing: border-box;
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    width: auto;
    height: 100%;
    align-items: center;
    justify-content: flex-start;
    padding-left: 13px;
    padding-right: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--cpg-body-font, 'Jost', sans-serif);
    font-size: 16px;
    font-weight: 400;
    line-height: 100%;
    letter-spacing: -0.02em;
    color: #000000;
    text-align: left;
  }

  /* Once a size is selected: horizontally centered within the 216px left compartment */
  .cpg-select__trigger.has-value .cpg-select__value,
  .cpg-select__trigger[data-has-value="true"] .cpg-select__value,
  .cpg-select__value.has-value,
  .cpg-select__value.is-selected,
  .cpg-select__value[data-has-value="true"] {
    justify-content: center;
    text-align: center;
    padding-left: 0;
    padding-right: 0;
  }

  .cpg-select__icon {
    box-sizing: border-box;
    display: flex;
    flex: 0 0 55px;
    width: 55px;
    max-width: 55px;
    height: 100%;
    align-self: center;
    align-items: center;
    justify-content: center;
    border-left: 1px solid #000000;
    padding: 0;
    margin: 0;
  }

  .cpg-select__chevron {
    display: block;
    width: 12px;
    height: 6px;
    color: #000000;
    stroke: #000000;
    transition: transform 300ms ease-out;
  }

  .cpg-select.is-open .cpg-select__chevron,
  .cpg-select__trigger[aria-expanded="true"] .cpg-select__chevron {
    transform: rotate(180deg);
  }

  .cpg-select__trigger:focus-visible {
    outline: 2px solid #000000;
    outline-offset: -2px;
  }

  .cpg-select__menu {
    box-sizing: border-box;
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 10;
    width: 100%;
    height: 99px;
    max-height: 99px;
    margin: -1px 0 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background-color: #ffffff;
    border: 1px solid #000000;
    list-style: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .cpg-select__menu::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .cpg-select.is-dropup .cpg-select__menu {
    top: auto;
    bottom: 100%;
    margin: 0 0 -1px;
  }

  .cpg-select__option {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 33px;
    min-height: 33px;
    max-height: 33px;
    padding: 0 10px;
    margin: 0;
    background-color: #ffffff;
    color: #000000;
    cursor: pointer;
    font-family: var(--cpg-body-font, 'Jost', sans-serif);
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    text-align: center;
    user-select: none;
    outline: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  /* Default State: Background #FFFFFF, color #000000. NO item is pre-highlighted or auto-hovered */
  .cpg-select__option,
  .cpg-select__option:not(:hover),
  .cpg-select__option.is-selected:not(:hover),
  .cpg-select__option[aria-selected="true"]:not(:hover) {
    background-color: #ffffff;
    color: #000000;
  }

  /* Hover State (:hover ONLY): background smoothly or cleanly turns #000000 and text turns #FFFFFF */
  .cpg-select__option:hover {
    background-color: #000000;
    color: #ffffff;
    outline: none;
  }

  .cpg-select__option:focus-visible {
    outline: none;
  }

  /* Add to cart: black with a yellow sliding fill on hover. */
  .cpg-modal__submit {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 45px;
    margin: 50px 0 0;
    padding: 0 20px;
    overflow: hidden;
    background-color: var(--cpg-ink);
    border: 1px solid var(--cpg-ink);
    border-radius: 0;
    color: #ffffff;
    cursor: pointer;
    font-family: var(--cpg-body-font);
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.05em;
    line-height: 1.28;
    text-transform: uppercase;
    transition: color 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .cpg-modal__submit::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--cpg-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .cpg-modal__submit:hover:not(:disabled)::before,
  .cpg-modal__submit:focus-visible:not(:disabled)::before {
    transform: scaleX(1);
  }

  .cpg-modal__submit:hover:not(:disabled),
  .cpg-modal__submit:focus-visible:not(:disabled) {
    color: var(--cpg-ink);
  }

  .cpg-modal__submit:focus-visible {
    outline: 2px solid var(--cpg-ink);
    outline-offset: 3px;
  }

  .cpg-modal__submit:disabled {
    background-color: #e0e0e0;
    border-color: #e0e0e0;
    color: #888888;
    cursor: not-allowed;
  }

  .cpg-modal__submit:disabled::before {
    display: none;
  }

  .cpg-modal__submit.is-added {
    background-color: var(--cpg-ink);
    border-color: var(--cpg-ink);
    color: #ffffff;
    cursor: default;
  }

  .cpg-modal__submit[aria-busy='true'] {
    cursor: wait;
    opacity: 0.8;
  }

  .cpg-modal__submit-arrow {
    flex: none;
    width: 34px;
    height: 8px;
    transition: transform 0.25s ease;
  }

  .cpg-modal__submit:hover:not(:disabled) .cpg-modal__submit-arrow {
    transform: translateX(4px);
  }

  .cpg-modal__notice {
    margin: 8px 0 0;
    color: var(--cpg-error);
    font-family: var(--cpg-body-font);
    font-size: 13px;
    line-height: 1.3;
    text-align: center;
  }

  .cpg-modal__notice:empty {
    display: none;
  }

  .cpg-modal__notice[data-state='success'] {
    color: var(--cpg-success);
  }

  /* Scroll lock while a quick view is open. */
  html.cpg-modal-open,
  html.cpg-modal-open body {
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .cpg__inner {
      padding: 30px 16px 40px;
    }

    .cpg__heading {
      margin-bottom: 20px;
      font-size: 24px;
      line-height: 1.2;
      text-align: center;
    }

    .cpg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4px;
    }

    .cpg-card {
      aspect-ratio: 169 / 186.4;
    }

    .cpg-card__hotspot {
      width: 16px;
      height: 16px;
    }

    .cpg-card__hotspot::before {
      inset: -14px;
    }

    .cpg-card__hotspot-icon {
      width: 6px;
      height: 6px;
    }

    .cpg-modal {
      padding: 32px 20px 20px;
    }
  }

  @media screen and (max-height: 560px) {
    .cpg-modal {
      max-height: calc(100dvh - 24px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cpg *,
    .cpg *::before,
    .cpg *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }

    .cpg-card:hover .cpg-card__image {
      transform: none;
    }
  }
{% endstylesheet %}

<script type="module">
  import { CartErrorEvent, CartLinesUpdateEvent } from '@shopify/events';
  import { formatMoney } from '@theme/money-formatting';

  const GRID_SELECTOR = '[data-custom-product-grid]';
  const instances = new Map();
  const COLOR_HEX = {
    black: '#000000',
    white: '#ffffff',
    'off white': '#f5f1e8',
    ivory: '#fffff0',
    cream: '#fffdd0',
    blue: '#0d499f',
    navy: '#001f3f',
    'navy blue': '#001f3f',
    'royal blue': '#4169e1',
    'sky blue': '#87ceeb',
    'light blue': '#add8e6',
    'dark blue': '#002d62',
    denim: '#1560bd',
    red: '#b20f36',
    'dark red': '#8b0000',
    burgundy: '#800020',
    maroon: '#800000',
    pink: '#ffc0cb',
    green: '#2e7d32',
    olive: '#556b2f',
    'forest green': '#228b22',
    sage: '#9dc183',
    mint: '#98ff98',
    yellow: '#fff544',
    mustard: '#ffdb58',
    orange: '#ff7a00',
    brown: '#8b4513',
    chocolate: '#7b3f00',
    tan: '#d2b48c',
    beige: '#f5f5dc',
    khaki: '#c3b091',
    sand: '#c2b280',
    camel: '#c19a6b',
    grey: '#afafb7',
    gray: '#afafb7',
    'light grey': '#d3d3d3',
    'light gray': '#d3d3d3',
    'dark grey': '#5a5a5a',
    'dark gray': '#5a5a5a',
    charcoal: '#36454f',
    purple: '#800080',
    lavender: '#b57edc',
    teal: '#008080',
    turquoise: '#40e0d0',
    coral: '#ff7f50',
    gold: '#ffd700',
    silver: '#c0c0c0',
    wine: '#722f37',
    taupe: '#8b8589',
    multi: '#9e9e9e',
  };

  function normalize(value) {
    return String(value ?? '').trim().toLowerCase();
  }

  function parseJson(script, fallback) {
    if (!script) return fallback;

    try {
      const parsed = JSON.parse(script.textContent || '');
      return parsed ?? fallback;
    } catch (error) {
      console.warn('[custom-product-grid] Unable to parse product JSON.', error);
      return fallback;
    }
  }

  function optionValue(variant, index) {
    if (!variant) return '';

    if (Array.isArray(variant.options) && variant.options[index] != null) {
      return String(variant.options[index]);
    }

    const value = variant[`option${index + 1}`];
    return value == null ? '' : String(value);
  }

  function protocolUrl(url) {
    if (typeof url !== 'string' || !url) return '';
    return url.startsWith('//') ? `https:${url}` : url;
  }

  function variantImage(variant) {
    const image = variant?.featured_image;
    if (!image) return '';

    return protocolUrl(typeof image === 'string' ? image : image.src || '');
  }

  function resolveColor(name) {
    const raw = String(name || '').trim();
    if (!raw) return '#9e9e9e';
    if (/^#([0-9a-f]{3,8})$/i.test(raw) || /^(rgb|hsl)a?\(/i.test(raw)) return raw;

    const value = normalize(raw);
    if (COLOR_HEX[value]) return COLOR_HEX[value];

    const words = value.split(/[\s/_-]+/).filter(Boolean);
    for (const word of words) {
      if (COLOR_HEX[word]) return COLOR_HEX[word];
    }

    for (const [key, hex] of Object.entries(COLOR_HEX)) {
      if (value.includes(key)) return hex;
    }

    try {
      if (typeof CSS !== 'undefined' && typeof CSS.supports === 'function' && CSS.supports('color', value)) {
        return value;
      }
    } catch {
      // Ignore unsupported CSS color parsing and use the neutral fallback.
    }

    return '#9e9e9e';
  }

  function syncModalScrollLock() {
    const hasOpenModal = Boolean(document.querySelector('dialog.cpg-modal[open]'));
    document.documentElement.classList.toggle('cpg-modal-open', hasOpenModal);
  }

  class CustomProductGrid {
    constructor(section) {
      this.section = section;
      this.dialog = section.querySelector('[data-cpg-dialog]');
      this.modalImage = section.querySelector('[data-cpg-image]');
      this.modalTitle = section.querySelector('[data-cpg-title]');
      this.modalPrice = section.querySelector('[data-cpg-price]');
      this.modalDescription = section.querySelector('[data-cpg-description]');
      this.colorSection = section.querySelector('[data-cpg-color-section]');
      this.colorOptions = section.querySelector('[data-cpg-colors]');
      this.sizeSection = section.querySelector('[data-cpg-size-section]');
      this.sizeSelect = section.querySelector('[data-cpg-select]');
      this.sizeTrigger = section.querySelector('[data-cpg-size-trigger]');
      this.sizeValue = section.querySelector('[data-cpg-size-value]');
      this.sizeMenu = section.querySelector('[data-cpg-size-menu]');
      this.submit = section.querySelector('[data-cpg-submit]');
      this.submitText = section.querySelector('[data-cpg-submit-text]');
      this.notice = section.querySelector('[data-cpg-notice]');

      this.moneyFormat = section.dataset.moneyFormat || '';
      this.currency = section.dataset.currency || 'USD';

      this.currentProduct = null;
      this.colorIndex = -1;
      this.sizeIndex = -1;
      this.colorValues = [];
      this.sizeValues = [];
      this.colorButtons = [];
      this.sizeOptions = [];
      this.selectedColor = '';
      this.selectedSize = '';
      this.isAdding = false;
      this.addToken = null;
      this.addController = null;
      this.dropdownAbort = null;
      this.abort = new AbortController();

      this.handleClick = this.handleClick.bind(this);
      this.handleKeydown = this.handleKeydown.bind(this);
      this.handleDialogClick = this.handleDialogClick.bind(this);
      this.handleDialogClose = this.handleDialogClose.bind(this);
      this.handleOutsidePointer = this.handleOutsidePointer.bind(this);
      this.handleImageError = this.handleImageError.bind(this);
    }

    connect() {
      const { signal } = this.abort;

      this.section.addEventListener('click', this.handleClick, { signal });
      this.section.addEventListener('keydown', this.handleKeydown, { signal });
      this.dialog.addEventListener('click', this.handleDialogClick, { signal });
      this.dialog.addEventListener('close', this.handleDialogClose, { signal });
      this.modalImage.addEventListener('error', this.handleImageError, { signal });
    }

    destroy() {
      this.abort.abort();
      this.dropdownAbort?.abort();
      this.addController?.abort();

      if (this.dialog.open) this.dialog.close();
      this.section.removeAttribute('data-cpg-initialized');
      syncModalScrollLock();
    }

    /* ---------------------------------------------------------------------
       Product data
       --------------------------------------------------------------------- */

    readProduct(dataElement) {
      if (!dataElement) return null;

      const options = parseJson(dataElement.querySelector('.product-options-json'), []);
      const variants = parseJson(dataElement.querySelector('.product-variants-json'), []);

      return {
        baseVariantId: dataElement.dataset.variantId || '',
        title: dataElement.dataset.title || '',
        priceLabel: dataElement.dataset.price || '',
        image: dataElement.dataset.image || '',
        description: dataElement.dataset.description || '',
        options: Array.isArray(options) ? options : [],
        variants: Array.isArray(variants) ? variants : [],
      };
    }

    findOptionIndex(names) {
      if (!this.currentProduct) return -1;

      return this.currentProduct.options.findIndex((option) => {
        return names.includes(normalize(option?.name));
      });
    }

    getOptionValues(index) {
      if (!this.currentProduct || index < 0) return [];

      const declared = Array.isArray(this.currentProduct.options[index]?.values)
        ? this.currentProduct.options[index].values.map((value) => String(value))
        : [];

      const present = new Set();
      const variantOrder = [];

      for (const variant of this.currentProduct.variants) {
        const value = optionValue(variant, index);
        if (value && !present.has(value)) {
          present.add(value);
          variantOrder.push(value);
        }
      }

      const ordered = declared.filter((value) => present.has(value));
      const extras = variantOrder.filter((value) => !ordered.includes(value));

      return ordered.concat(extras);
    }

    getBaseVariant() {
      const product = this.currentProduct;
      if (!product) return null;

      const baseId = String(product.baseVariantId || '');
      const baseVariant = product.variants.find((variant) => String(variant.id) === baseId);

      if (baseVariant) return baseVariant;
      if (!product.variants.length && product.baseVariantId) {
        return {
          id: product.baseVariantId,
          available: true,
          price: null,
          featured_image: null,
        };
      }

      return product.variants.find((variant) => variant.available !== false) || product.variants[0] || null;
    }

    hasRequiredSelections() {
      const needsColor = this.colorValues.length > 0;
      const needsSize = this.sizeValues.length > 0;

      return (!needsColor || Boolean(this.selectedColor)) && (!needsSize || Boolean(this.selectedSize));
    }

    getExactVariant() {
      const product = this.currentProduct;
      if (!product) return null;

      if (!this.colorValues.length && !this.sizeValues.length) {
        return this.getBaseVariant();
      }

      if (!this.hasRequiredSelections()) return null;

      const matches = product.variants.filter((variant) => {
        const colorMatches =
          !this.colorValues.length ||
          normalize(optionValue(variant, this.colorIndex)) === normalize(this.selectedColor);
        const sizeMatches =
          !this.sizeValues.length ||
          normalize(optionValue(variant, this.sizeIndex)) === normalize(this.selectedSize);

        return colorMatches && sizeMatches;
      });

      return matches.find((variant) => variant.available !== false) || matches[0] || null;
    }

    getPreviewVariant() {
      const product = this.currentProduct;
      if (!product) return null;
      if (!product.variants.length) return this.getBaseVariant();

      const matches = product.variants.filter((variant) => {
        const colorMatches =
          !this.colorValues.length ||
          !this.selectedColor ||
          normalize(optionValue(variant, this.colorIndex)) === normalize(this.selectedColor);
        const sizeMatches =
          !this.sizeValues.length ||
          !this.selectedSize ||
          normalize(optionValue(variant, this.sizeIndex)) === normalize(this.selectedSize);

        return colorMatches && sizeMatches;
      });

      return matches.find((variant) => variant.available !== false) || matches[0] || null;
    }

    productIsSoldOut() {
      const variants = this.currentProduct?.variants || [];
      return variants.length > 0 && variants.every((variant) => variant.available === false);
    }

    /* ---------------------------------------------------------------------
       Dialog rendering
       --------------------------------------------------------------------- */

    resetModal() {
      this.currentProduct = null;
      this.colorIndex = -1;
      this.sizeIndex = -1;
      this.colorValues = [];
      this.sizeValues = [];
      this.colorButtons = [];
      this.sizeOptions = [];
      this.selectedColor = '';
      this.selectedSize = '';
      this.isAdding = false;
      this.addToken = null;

      this.modalTitle.textContent = '';
      this.modalPrice.textContent = '';
      this.modalDescription.textContent = '';
      this.modalImage.hidden = true;
      this.modalImage.removeAttribute('src');
      this.modalImage.alt = '';

      this.colorOptions.replaceChildren();
      this.sizeMenu.replaceChildren();
      this.sizeMenu.style.width = '';
      this.sizeMenu.style.left = '';
      this.colorSection.hidden = true;
      this.sizeSection.hidden = true;
      this.sizeValue.textContent = 'Choose your size';
      this.sizeValue.classList.remove('has-value');
      this.sizeTrigger.classList.remove('has-value');
      this.sizeSelect.classList.remove('has-value');
      this.sizeValue.removeAttribute('data-has-value');
      this.sizeTrigger.removeAttribute('data-has-value');
      this.closeSizeMenu();

      this.submit.classList.remove('is-added');
      this.setSubmitState('add');
      this.setNotice('', '');
      this.submit.removeAttribute('aria-busy');
    }

    renderProduct(product) {
      this.currentProduct = product;
      this.colorIndex = this.findOptionIndex(['color', 'colour']);
      this.sizeIndex = this.findOptionIndex(['size']);
      this.colorValues = this.getOptionValues(this.colorIndex);
      this.sizeValues = this.getOptionValues(this.sizeIndex);

      this.modalTitle.textContent = product.title;
      this.modalPrice.textContent = product.priceLabel;
      this.modalDescription.textContent = product.description;
      this.setImage(product.image || variantImage(this.getBaseVariant()));

      this.renderColors();
      this.renderSizes();
      this.updateVariant();
    }

    renderColors() {
      this.colorOptions.replaceChildren();
      this.colorButtons = [];
      this.colorSection.hidden = this.colorValues.length === 0;

      for (const [index, value] of this.colorValues.entries()) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'cpg-color color-swatch';
        button.dataset.cpgColor = '';
        button.dataset.value = value;
        button.dataset.color = value;
        button.setAttribute('data-color', value);
        button.setAttribute('role', 'radio');
        button.setAttribute('aria-checked', 'false');
        button.tabIndex = index === 0 ? 0 : -1;
        button.style.setProperty('--cpg-swatch', resolveColor(value));

        if (normalize(value) === 'black') {
          button.classList.add('cpg-color--black');
        }

        const label = document.createElement('span');
        label.className = 'cpg-color__label';
        label.textContent = value;
        button.append(label);

        this.colorButtons.push(button);
        this.colorOptions.append(button);
      }

      if (this.colorValues.length === 1) {
        this.setColor(this.colorValues[0], { update: false });
      }
    }

    renderSizes() {
      this.sizeMenu.replaceChildren();
      this.sizeOptions = [];
      this.sizeSection.hidden = this.sizeValues.length === 0;
      this.sizeValue.textContent = 'Choose your size';
      this.sizeValue.classList.remove('has-value');
      this.sizeTrigger.classList.remove('has-value');
      this.sizeSelect.classList.remove('has-value');
      this.sizeValue.removeAttribute('data-has-value');
      this.sizeTrigger.removeAttribute('data-has-value');
      this.sizeTrigger.setAttribute('aria-expanded', 'false');
      this.sizeSelect.classList.remove('is-open', 'is-dropup');
      this.sizeMenu.hidden = true;

      for (const value of this.sizeValues) {
        const option = document.createElement('li');
        option.className = 'cpg-select__option';
        option.dataset.cpgSizeOption = '';
        option.dataset.value = value;
        option.setAttribute('role', 'option');
        option.setAttribute('aria-selected', 'false');
        option.tabIndex = -1;
        option.textContent = value;

        this.sizeOptions.push(option);
        this.sizeMenu.append(option);
      }

      if (this.sizeValues.length === 1) {
        this.setSize(this.sizeValues[0], { update: false, focusTrigger: false });
      }
    }

    setColor(value, { update = true } = {}) {
      this.selectedColor = value;

      for (const button of this.colorButtons) {
        const selected = button.dataset.value === value;
        button.classList.toggle('is-selected', selected);
        button.setAttribute('aria-checked', selected ? 'true' : 'false');
        button.tabIndex = selected ? 0 : -1;
      }

      if (update) {
        this.setNotice('', '');
        this.updateVariant();
      }
    }

    setSize(value, { update = true, focusTrigger = true } = {}) {
      this.selectedSize = value;
      const hasValue = Boolean(value && value !== 'Choose your size');
      this.sizeValue.textContent = value || 'Choose your size';
      this.sizeValue.classList.toggle('has-value', hasValue);
      this.sizeTrigger.classList.toggle('has-value', hasValue);
      this.sizeSelect.classList.toggle('has-value', hasValue);
      if (hasValue) {
        this.sizeValue.dataset.hasValue = 'true';
        this.sizeTrigger.dataset.hasValue = 'true';
      } else {
        delete this.sizeValue.dataset.hasValue;
        delete this.sizeTrigger.dataset.hasValue;
      }

      for (const option of this.sizeOptions) {
        const selected = option.dataset.value === value;
        option.classList.toggle('is-selected', selected);
        option.setAttribute('aria-selected', selected ? 'true' : 'false');
      }

      this.closeSizeMenu(focusTrigger);

      if (update) {
        this.setNotice('', '');
        this.updateVariant();
      }
    }

    updateVariant() {
      const product = this.currentProduct;
      if (!product || this.isAdding) return;

      const exact = this.getExactVariant();
      const preview = exact || this.getPreviewVariant();
      const complete = this.hasRequiredSelections();
      const hasSelection = Boolean(this.selectedColor || this.selectedSize);
      const soldOut = this.productIsSoldOut();

      if (exact && exact.price != null) {
        this.setPrice(exact.price);
      } else {
        // Fall back to the base product price when no single variant matches
        // yet, so a previously selected variant's price never goes stale.
        this.modalPrice.textContent = product.priceLabel;
      }

      const image = (hasSelection && preview && variantImage(preview)) || (exact && variantImage(exact)) || product.image;
      this.setImage(image);

      if (exact) {
        const available = exact.available !== false;
        this.setSubmitState(available ? 'add' : 'soldout');
        if (!available) this.setNotice('This variant is sold out.', 'error');
      } else if (complete) {
        this.setSubmitState('soldout');
        this.setNotice('This combination is unavailable.', 'error');
      } else if (soldOut) {
        this.setSubmitState('soldout');
        this.setNotice('This product is sold out.', 'error');
      } else {
        this.setSubmitState('add');
      }
    }

    setSubmitState(state) {
      this.submit.disabled = state !== 'add';
      this.submitText.textContent = state === 'soldout' ? 'SOLD OUT' : 'ADD TO CART';
      this.submit.removeAttribute('aria-busy');
    }

    setPrice(cents) {
      const value = Number(cents);
      if (!Number.isFinite(value)) return;

      this.modalPrice.textContent = this.formatPrice(value);
    }

    formatPrice(cents) {
      try {
        if (this.moneyFormat) {
          return formatMoney(cents, this.moneyFormat, this.currency);
        }

        return new Intl.NumberFormat(document.documentElement.lang || undefined, {
          style: 'currency',
          currency: this.currency,
        }).format(cents / 100);
      } catch {
        return `${(cents / 100).toFixed(2)} ${this.currency}`;
      }
    }

    setImage(url) {
      const safeUrl = protocolUrl(url || '');
      const title = this.currentProduct?.title || '';

      if (!safeUrl) {
        this.modalImage.hidden = true;
        this.modalImage.removeAttribute('src');
        this.modalImage.alt = '';
        return;
      }

      if (this.modalImage.getAttribute('src') !== safeUrl) {
        this.modalImage.src = safeUrl;
      }

      this.modalImage.alt = title;
      this.modalImage.hidden = false;
    }

    setNotice(message, state = '') {
      this.notice.textContent = message;
      if (state) {
        this.notice.dataset.state = state;
      } else {
        this.notice.removeAttribute('data-state');
      }
    }

    /* ---------------------------------------------------------------------
       Open / close
       --------------------------------------------------------------------- */

    open(card) {
      const dataElement = card.querySelector('.hidden-product-data');
      if (!dataElement) return;

      const product = this.readProduct(dataElement);
      if (!product) return;

      this.resetModal();
      this.renderProduct(product);

      if (this.dialog.open) this.dialog.close();
      this.dialog.showModal();
      syncModalScrollLock();

      this.dialog.querySelector('[data-cpg-close]')?.focus({ preventScroll: true });
    }

    closeDialog() {
      if (this.dialog.open) this.dialog.close();
    }

    handleDialogClose() {
      this.closeSizeMenu(false);
      syncModalScrollLock();
      this.isAdding = false;
      this.addToken = null;
    }

    handleDialogClick(event) {
      if (event.target !== this.dialog) return;

      const rect = this.dialog.getBoundingClientRect();
      const { clientX, clientY } = event;
      const inside =
        clientX >= rect.left &&
        clientX <= rect.right &&
        clientY >= rect.top &&
        clientY <= rect.bottom;

      if (!inside) this.closeDialog();
    }

    /* ---------------------------------------------------------------------
       Interactions
       --------------------------------------------------------------------- */

    handleClick(event) {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      if (target.closest('[data-cpg-close]')) {
        event.preventDefault();
        this.closeDialog();
        return;
      }

      const hotspot = target.closest('[data-cpg-hotspot]');
      if (hotspot) {
        event.preventDefault();
        const card = hotspot.closest('[data-cpg-card]');
        if (card) this.open(card);
        return;
      }

      const color = target.closest('[data-cpg-color]');
      if (color) {
        event.preventDefault();
        this.setColor(color.dataset.value || '');
        return;
      }

      if (target.closest('[data-cpg-size-trigger]')) {
        event.preventDefault();
        this.toggleSizeMenu();
        return;
      }

      const sizeOption = target.closest('[data-cpg-size-option]');
      if (sizeOption) {
        event.preventDefault();
        this.setSize(sizeOption.dataset.value || '', { focusTrigger: true });
        return;
      }

      if (target.closest('[data-cpg-submit]')) {
        event.preventDefault();
        this.addToCart();
      }
    }

    handleKeydown(event) {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      const color = target.closest('[data-cpg-color]');
      if (color) {
        this.handleColorKeydown(event, color);
        return;
      }

      const sizeOption = target.closest('[data-cpg-size-option]');
      if (sizeOption) {
        this.handleSizeOptionKeydown(event, sizeOption);
        return;
      }

      if (target.closest('[data-cpg-size-trigger]')) {
        const expanded = this.sizeTrigger.getAttribute('aria-expanded') === 'true';

        if (event.key === 'Escape' && expanded) {
          event.preventDefault();
          this.closeSizeMenu(true);
          return;
        }

        if (event.key === 'Tab' && expanded) {
          this.closeSizeMenu(false);
          return;
        }

        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          this.openSizeMenu(event.key === 'ArrowUp');
        }
      }
    }

    handleColorKeydown(event, color) {
      const index = this.colorButtons.indexOf(color);
      if (index < 0) return;

      let nextIndex = index;

      switch (event.key) {
        case 'ArrowRight':
        case 'ArrowDown':
          nextIndex = (index + 1) % this.colorButtons.length;
          break;
        case 'ArrowLeft':
        case 'ArrowUp':
          nextIndex = (index - 1 + this.colorButtons.length) % this.colorButtons.length;
          break;
        case 'Home':
          nextIndex = 0;
          break;
        case 'End':
          nextIndex = this.colorButtons.length - 1;
          break;
        default:
          return;
      }

      event.preventDefault();
      const next = this.colorButtons[nextIndex];
      if (!next) return;

      next.focus();
      this.setColor(next.dataset.value || '');
    }

    handleSizeOptionKeydown(event, option) {
      const options = this.sizeOptions;
      const index = options.indexOf(option);
      if (index < 0) return;

      switch (event.key) {
        case 'Enter':
        case ' ':
          event.preventDefault();
          this.setSize(option.dataset.value || '', { focusTrigger: true });
          break;
        case 'ArrowDown':
          event.preventDefault();
          options[(index + 1) % options.length]?.focus();
          break;
        case 'ArrowUp':
          event.preventDefault();
          options[(index - 1 + options.length) % options.length]?.focus();
          break;
        case 'Home':
          event.preventDefault();
          options[0]?.focus();
          break;
        case 'End':
          event.preventDefault();
          options[options.length - 1]?.focus();
          break;
        case 'Escape':
          event.preventDefault();
          this.closeSizeMenu(true);
          break;
        case 'Tab':
          this.closeSizeMenu(false);
          break;
        default:
          break;
      }
    }

    toggleSizeMenu() {
      if (this.sizeTrigger.getAttribute('aria-expanded') === 'true') {
        this.closeSizeMenu(false);
      } else {
        this.openSizeMenu(false);
      }
    }

    syncSizeMenuGeometry() {
      if (!this.sizeMenu || this.sizeMenu.hidden) return;

      const triggerRect = this.sizeTrigger.getBoundingClientRect();
      if (!triggerRect.width) return;

      const dpr = window.devicePixelRatio || 1;
      // In Chromium / Blink, absolutely positioned layers calculate used width via
      // floor(width * dpr), which renders 1 physical device pixel narrower than
      // in-flow button/block borders that snap to round(left + width * dpr).
      // Adding exactly 1 device pixel (1 / dpr) guarantees the right border aligns
      // seamlessly with the trigger button and the Add to Cart button on high-DPI screens.
      const devicePixelCompensation = dpr > 1 ? (1 / dpr) : 0;

      this.sizeMenu.style.left = '0px';
      this.sizeMenu.style.width = `${triggerRect.width + devicePixelCompensation}px`;

      // Read back live rect: if any sub-pixel right delta remains, compensate it
      const menuRect = this.sizeMenu.getBoundingClientRect();
      const rightDelta = triggerRect.right - menuRect.right;
      if (rightDelta > 0.05) {
        this.sizeMenu.style.width = `${parseFloat(this.sizeMenu.style.width) + rightDelta}px`;
      }
    }

    openSizeMenu(focusLast = false) {
      if (!this.sizeOptions.length) return;

      this.sizeMenu.hidden = false;
      this.sizeTrigger.setAttribute('aria-expanded', 'true');
      this.sizeSelect.classList.add('is-open');

      this.sizeSelect.classList.remove('is-dropup');
      this.syncSizeMenuGeometry();

      const triggerRect = this.sizeTrigger.getBoundingClientRect();
      const menuHeight = Math.min(this.sizeMenu.scrollHeight || 99, 99);
      const spaceBelow = window.innerHeight - triggerRect.bottom;
      const spaceAbove = triggerRect.top;

      if (spaceBelow < menuHeight + 8 && spaceAbove > spaceBelow) {
        this.sizeSelect.classList.add('is-dropup');
      }

      window.requestAnimationFrame(() => {
        this.syncSizeMenuGeometry();
        if (focusLast) {
          const options = this.sizeOptions;
          const target = options[options.length - 1];
          target?.focus();
        }
      });

      this.dropdownAbort?.abort();
      this.dropdownAbort = new AbortController();
      document.addEventListener('pointerdown', this.handleOutsidePointer, {
        capture: true,
        signal: this.dropdownAbort.signal,
      });
      window.addEventListener(
        'resize',
        () => {
          this.syncSizeMenuGeometry();
        },
        { signal: this.dropdownAbort.signal }
      );
    }

    closeSizeMenu(focusTrigger = false) {
      this.sizeMenu.hidden = true;
      this.sizeTrigger.setAttribute('aria-expanded', 'false');
      this.sizeSelect.classList.remove('is-open', 'is-dropup');

      this.dropdownAbort?.abort();
      this.dropdownAbort = null;

      if (focusTrigger) this.sizeTrigger.focus({ preventScroll: true });
    }

    handleOutsidePointer(event) {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (this.sizeSelect.contains(target)) return;

      this.closeSizeMenu(false);
    }

    handleImageError() {
      this.modalImage.hidden = true;
    }

    /* ---------------------------------------------------------------------
       Add to cart
       --------------------------------------------------------------------- */

    async addToCart() {
      if (this.isAdding || !this.currentProduct) return;

      if (this.colorValues.length && !this.selectedColor) {
        this.setNotice('Please choose a color.', 'error');
        this.colorButtons[0]?.focus();
        return;
      }

      if (this.sizeValues.length && !this.selectedSize) {
        this.setNotice('Please choose your size.', 'error');
        this.sizeTrigger.focus({ preventScroll: true });
        this.openSizeMenu(false);
        return;
      }

      const variant = this.getExactVariant() || this.getBaseVariant();
      if (!variant) {
        this.setNotice('This product is currently unavailable.', 'error');
        return;
      }

      const variantId = Number(variant.id);
      if (!Number.isFinite(variantId) || variantId <= 0) {
        this.setNotice('This product is currently unavailable.', 'error');
        return;
      }

      if (variant.available === false) {
        this.setNotice('This variant is sold out.', 'error');
        return;
      }

      const items = [{ id: variantId, quantity: 1 }];
      const bonusVariantId = Number(this.section.dataset.bonusVariantId);
      const bonusAvailable = this.section.dataset.bonusAvailable !== 'false';
      const isBlack = normalize(this.selectedColor) === 'black';
      const isMedium = ['m', 'medium'].includes(normalize(this.selectedSize));
      const shouldAddBonus =
        isBlack &&
        isMedium &&
        bonusAvailable &&
        Number.isFinite(bonusVariantId) &&
        bonusVariantId > 0 &&
        bonusVariantId !== variantId;

      if (shouldAddBonus) {
        items.push({ id: bonusVariantId, quantity: 1 });
      }

      this.isAdding = true;
      this.setNotice('', '');
      this.submit.disabled = true;
      this.submit.setAttribute('aria-busy', 'true');
      this.submitText.textContent = 'ADDING...';

      const token = Symbol('add-to-cart');
      this.addToken = token;

      const controller = new AbortController();
      this.addController = controller;

      const addUrl = this.section.dataset.cartAddUrl || '/cart/add.js';
      const cartUrl = this.section.dataset.cartUrl || '/cart.js';

      try {
        const response = await fetch(addUrl, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ items }),
          signal: controller.signal,
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok || data.status) {
          throw new Error(data.description || data.message || 'Unable to add this item to the cart.');
        }

        let cart = null;

        try {
          const cartResponse = await fetch(cartUrl, {
            headers: { Accept: 'application/json' },
            cache: 'no-store',
            signal: controller.signal,
          });

          if (cartResponse.ok) cart = await cartResponse.json();
        } catch (error) {
          if (error.name === 'AbortError') throw error;
        }

        const fallbackItemCount = Number(data.item_count);
        const itemCount = Number.isFinite(Number(cart?.item_count))
          ? Number(cart.item_count)
          : Number.isFinite(fallbackItemCount) && fallbackItemCount > 0
            ? fallbackItemCount
            : items.reduce((total, item) => total + item.quantity, 0);

        const deferred = CartLinesUpdateEvent.createPromise();
        const lines = items.map((item) => ({
          merchandiseId: String(item.id),
          quantity: item.quantity,
        }));

        this.dialog.dispatchEvent(
          new CartLinesUpdateEvent({
            action: 'add',
            context: 'dialog',
            lines,
            promise: deferred.promise,
            detail: { source: 'custom-product-grid' },
          })
        );

        deferred.resolve({
          cart: cart
            ? CartLinesUpdateEvent.createCartFromAjaxResponse(cart)
            : { totalQuantity: itemCount },
          detail: {
            didError: false,
            itemCount,
            items: cart?.items,
            source: 'custom-product-grid',
          },
        });

        if (this.addToken !== token) return;

        if (this.dialog.open) {
          // Keep isAdding true until the dialog's close event so option changes
          // cannot overwrite the success state during the brief confirmation.
          this.submit.disabled = true;
          this.submit.classList.add('is-added');
          this.submit.removeAttribute('aria-busy');
          this.submitText.textContent = shouldAddBonus ? 'ADDED WITH BONUS!' : 'ADDED!';
          this.setNotice(
            shouldAddBonus ? 'Added to cart with a bonus item.' : 'Added to cart.',
            'success'
          );

          window.setTimeout(() => {
            if (this.dialog.open && this.addToken === token) this.closeDialog();
          }, 900);
        } else {
          this.isAdding = false;
        }
      } catch (error) {
        if (error.name === 'AbortError') return;

        this.isAdding = false;

        if (this.addToken === token && this.dialog.open) {
          const rawMessage = error?.message || '';
          const message = /failed to fetch|load failed|networkerror/i.test(rawMessage)
            ? 'Unable to connect. Please check your connection and try again.'
            : rawMessage || 'Something went wrong. Please try again.';

          this.submit.removeAttribute('aria-busy');
          this.setSubmitState('add');
          this.setNotice(message, 'error');

          this.dialog.dispatchEvent(
            new CartErrorEvent({
              error: message,
              code: 'INVALID',
            })
          );
        }
      }
    }
  }

  function initSection(section) {
    if (!(section instanceof HTMLElement)) return;
    if (section.dataset.cpgInitialized === 'true') return;

    const key = section.id;
    if (!key) return;

    section.dataset.cpgInitialized = 'true';

    const instance = new CustomProductGrid(section);
    instances.set(key, instance);
    instance.connect();
  }

  function initWithin(root) {
    if (!(root instanceof Element) && !(root instanceof Document)) return;

    if (root instanceof Element && root.matches(GRID_SELECTOR)) {
      initSection(root);
    }

    root.querySelectorAll(GRID_SELECTOR).forEach(initSection);
  }

  function destroyWithin(root) {
    if (!(root instanceof Element)) return;

    const section = root.matches(GRID_SELECTOR) ? root : root.querySelector(GRID_SELECTOR);
    if (!section) return;

    const instance = instances.get(section.id);
    if (!instance) return;

    instance.destroy();
    instances.delete(section.id);
  }

  initWithin(document);

  document.addEventListener('shopify:section:load', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    destroyWithin(target);
    initWithin(target);
  });

  document.addEventListener('shopify:section:unload', (event) => {
    const target = event.target;
    if (target instanceof Element) destroyWithin(target);
  });
</script>

