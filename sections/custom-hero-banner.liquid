{% comment %}
  Custom Hero Banner Section
  Pixel-perfect implementation from Figma design:
  - Top Bar (Header Banner) with logo, tagline, and animated CTA button
  - Main Hero Area with line-art illustration and bottom-left content box
  - Pure CSS sliding fill button hover animations
  - Bottom Announcement Bar
  - Mobile collapsible header drawer behavior
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">

{%- style -%}
  #CustomHero-{{ section.id }} {
    --ch-font-family: 'Jost', -apple-system, BlinkMacSystemFont, sans-serif;
    --ch-top-bar-bg: {{ section.settings.top_bar_bg_color }};
    --ch-top-bar-text: {{ section.settings.top_bar_text_color }};
    --ch-top-bar-btn-bg: {{ section.settings.top_bar_btn_bg_color }};
    --ch-top-bar-btn-text: {{ section.settings.top_bar_btn_text_color }};
    --ch-top-bar-btn-hover-bg: {{ section.settings.top_bar_btn_hover_bg }};
    --ch-top-bar-btn-hover-text: {{ section.settings.top_bar_btn_hover_text }};

    --ch-hero-bg: {{ section.settings.hero_bg_color }};
    --ch-hero-heading: {{ section.settings.hero_heading_color }};
    --ch-hero-text: {{ section.settings.hero_text_color }};
    --ch-hero-btn-bg: {{ section.settings.hero_btn_bg_color }};
    --ch-hero-btn-text: {{ section.settings.hero_btn_text_color }};
    --ch-hero-btn-hover-bg: {{ section.settings.hero_btn_hover_bg }};
    --ch-hero-btn-hover-text: {{ section.settings.hero_btn_hover_text }};

    --ch-announcement-bg: {{ section.settings.announcement_bg_color }};
    --ch-announcement-text: {{ section.settings.announcement_text_color }};

    font-family: var(--ch-font-family);
    color: var(--ch-hero-text);
    background-color: var(--ch-hero-bg);
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }

  #CustomHero-{{ section.id }} *,
  #CustomHero-{{ section.id }} *::before,
  #CustomHero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #CustomHero-{{ section.id }} button,
  #CustomHero-{{ section.id }} input,
  #CustomHero-{{ section.id }} a {
    font-family: inherit;
  }

  /* -------------------------------------------------------------
     1. Top Bar / Header Banner
     ------------------------------------------------------------- */
  #CustomHero-{{ section.id }} .ch-top-bar {
    background-color: var(--ch-top-bar-bg);
    color: var(--ch-top-bar-text);
    width: 100%;
    position: relative;
    z-index: 1;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  #CustomHero-{{ section.id }} .ch-top-bar__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 10px 50px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  #CustomHero-{{ section.id }} .ch-brand-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--ch-top-bar-text);
    line-height: 1;
    flex-shrink: 0;
  }

  #CustomHero-{{ section.id }} .ch-brand-logo__img {
    height: 19px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  #CustomHero-{{ section.id }} .ch-brand-logo__text {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ch-top-bar-text);
    margin: 0;
  }

  #CustomHero-{{ section.id }} .ch-top-bar__tagline {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
    margin: 0;
    padding: 0 20px;
    color: var(--ch-top-bar-text);
    flex: 1;
  }

  #CustomHero-{{ section.id }} .ch-top-bar__cta {
    flex-shrink: 0;
    display: flex;
    justify-content: flex-end;
  }

  /* Mobile toggle button */
  #CustomHero-{{ section.id }} .ch-mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    width: 36px;
    height: 36px;
    position: relative;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  #CustomHero-{{ section.id }} .ch-hamburger-icon {
    width: 18px;
    height: 12px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  #CustomHero-{{ section.id }} .ch-hamburger-icon span {
    display: block;
    width: 100%;
    height: 1.5px;
    background-color: var(--ch-top-bar-text);
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  #CustomHero-{{ section.id }} .ch-mobile-toggle[aria-expanded="true"] .ch-hamburger-icon span:nth-child(1) {
    transform: translateY(5.25px) rotate(45deg);
  }

  #CustomHero-{{ section.id }} .ch-mobile-toggle[aria-expanded="true"] .ch-hamburger-icon span:nth-child(2) {
    opacity: 0;
  }

  #CustomHero-{{ section.id }} .ch-mobile-toggle[aria-expanded="true"] .ch-hamburger-icon span:nth-child(3) {
    transform: translateY(-5.25px) rotate(-45deg);
  }

  /* Mobile Collapsible Drawer */
  #CustomHero-{{ section.id }} .ch-mobile-drawer {
    display: none;
    max-height: 0;
    overflow: hidden;
    background-color: #F2F2F2;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  #CustomHero-{{ section.id }} .ch-mobile-drawer.is-open {
    max-height: 250px;
  }

  #CustomHero-{{ section.id }} .ch-mobile-drawer__content {
    padding: 20px 20px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  #CustomHero-{{ section.id }} .ch-mobile-drawer__tagline {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.35;
    color: #000000;
    margin: 0;
  }

  /* -------------------------------------------------------------
     2. Button Styles & Left-to-Right Sliding Hover Animation
     ------------------------------------------------------------- */
  #CustomHero-{{ section.id }} .ch-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-decoration: none;
    font-family: var(--ch-font-family);
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0 24px;
    border: 1px solid #000000;
    border-radius: 0;
    cursor: pointer;
    overflow: hidden;
    z-index: 1;
    transition: color 0.35s cubic-bezier(0.25, 1, 0.5, 1),
                border-color 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    white-space: nowrap;
  }

  #CustomHero-{{ section.id }} .ch-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: -1;
  }

  #CustomHero-{{ section.id }} .ch-btn:hover::before {
    transform: scaleX(1);
  }

  #CustomHero-{{ section.id }} .ch-btn svg {
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1),
                stroke 0.35s cubic-bezier(0.25, 1, 0.5, 1),
                fill 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  }

  #CustomHero-{{ section.id }} .ch-btn:hover svg {
    transform: translateX(3px);
  }

  /* Top Bar Button Modifier ("CHOOSE GIFT →") */
  #CustomHero-{{ section.id }} .ch-btn--top-bar {
    background-color: var(--ch-top-bar-btn-bg);
    color: var(--ch-top-bar-btn-text);
    border-color: #000000;
    height: 44px;
    min-width: 200px;
  }

  #CustomHero-{{ section.id }} .ch-btn--top-bar::before {
    background-color: var(--ch-top-bar-btn-hover-bg);
  }

  #CustomHero-{{ section.id }} .ch-btn--top-bar svg path {
    stroke: var(--ch-top-bar-btn-text);
    fill: var(--ch-top-bar-btn-text);
    transition: stroke 0.35s ease, fill 0.35s ease;
  }

  #CustomHero-{{ section.id }} .ch-btn--top-bar:hover {
    color: var(--ch-top-bar-btn-hover-text);
    border-color: var(--ch-top-bar-btn-hover-bg);
  }

  #CustomHero-{{ section.id }} .ch-btn--top-bar:hover svg path {
    stroke: var(--ch-top-bar-btn-hover-text);
    fill: var(--ch-top-bar-btn-hover-text);
  }

  /* Hero Content Button Modifier ("SHOP NOW →") */
  #CustomHero-{{ section.id }} .ch-btn--hero {
    background-color: var(--ch-hero-btn-bg);
    color: var(--ch-hero-btn-text);
    border-color: var(--ch-hero-btn-bg);
    height: 50px;
    min-width: 220px;
  }

  #CustomHero-{{ section.id }} .ch-btn--hero::before {
    background-color: var(--ch-hero-btn-hover-bg);
  }

  #CustomHero-{{ section.id }} .ch-btn--hero svg path {
    stroke: var(--ch-hero-btn-text);
    fill: var(--ch-hero-btn-text);
    transition: stroke 0.35s ease, fill 0.35s ease;
  }

  #CustomHero-{{ section.id }} .ch-btn--hero:hover {
    color: var(--ch-hero-btn-hover-text);
    border-color: #000000;
  }

  #CustomHero-{{ section.id }} .ch-btn--hero:hover svg path {
    stroke: var(--ch-hero-btn-hover-text);
    fill: var(--ch-hero-btn-hover-text);
  }

  /* -------------------------------------------------------------
     3. Main Hero Area
     ------------------------------------------------------------- */
  #CustomHero-{{ section.id }} .ch-main-hero {
    position: relative;
    width: 100%;
    min-height: 780px;
    background-color: var(--ch-hero-bg);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  #CustomHero-{{ section.id }} .ch-main-hero__artwork {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  #CustomHero-{{ section.id }} .ch-main-hero__artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    display: block;
  }

  #CustomHero-{{ section.id }} .ch-main-hero__artwork-desktop {
    display: block;
  }

  #CustomHero-{{ section.id }} .ch-main-hero__artwork-mobile {
    display: none;
  }

  #CustomHero-{{ section.id }} .ch-main-hero__container {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 67px;
  }

  #CustomHero-{{ section.id }} .ch-content-box {
    max-width: 500px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  #CustomHero-{{ section.id }} .ch-content-box__heading {
    font-size: 70px;
    font-weight: 500;
    line-height: 1;
    color: var(--ch-hero-heading);
    margin: 0 0 24px 0;
    letter-spacing: -0.01em;
  }

  #CustomHero-{{ section.id }} .ch-content-box__desc {
    font-size: 20px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--ch-hero-text);
    margin: 0 0 32px 0;
    max-width: 483px;
  }

  /* -------------------------------------------------------------
     4. Bottom Announcement Strip
     ------------------------------------------------------------- */
  #CustomHero-{{ section.id }} .ch-announcement {
    background-color: var(--ch-announcement-bg);
    color: var(--ch-announcement-text);
    width: 100%;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    position: relative;
    z-index: 1;
  }

  #CustomHero-{{ section.id }} .ch-announcement__text {
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
  }

  /* -------------------------------------------------------------
     Responsive Breakpoints (Mobile / Tablet)
     ------------------------------------------------------------- */
  @media screen and (max-width: 1024px) {
    #CustomHero-{{ section.id }} .ch-top-bar__inner {
      padding: 10px 30px;
    }

    #CustomHero-{{ section.id }} .ch-main-hero__container {
      padding: 50px 30px;
    }

    #CustomHero-{{ section.id }} .ch-content-box__heading {
      font-size: 52px;
    }

    #CustomHero-{{ section.id }} .ch-content-box__desc {
      font-size: 18px;
    }
  }

  @media screen and (max-width: 767px) {
    #CustomHero-{{ section.id }} .ch-top-bar__inner {
      height: 65px;
      padding: 0 20px;
      justify-content: space-between;
    }

    #CustomHero-{{ section.id }} .ch-mobile-toggle {
      display: inline-flex;
    }

    #CustomHero-{{ section.id }} .ch-top-bar__tagline {
      display: none;
    }

    #CustomHero-{{ section.id }} .ch-top-bar__cta {
      display: none;
    }

    #CustomHero-{{ section.id }} .ch-mobile-drawer {
      display: block;
    }

    #CustomHero-{{ section.id }} .ch-brand-logo {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    /* Main Hero Stacking on Mobile */
    #CustomHero-{{ section.id }} .ch-main-hero {
      min-height: auto;
      flex-direction: column;
      align-items: stretch;
    }

    #CustomHero-{{ section.id }} .ch-main-hero__artwork {
      position: relative;
      width: 100%;
      height: 260px;
    }

    #CustomHero-{{ section.id }} .ch-main-hero__artwork-desktop {
      display: none;
    }

    #CustomHero-{{ section.id }} .ch-main-hero__artwork-mobile {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    #CustomHero-{{ section.id }} .ch-main-hero__container {
      padding: 24px 20px 36px;
    }

    #CustomHero-{{ section.id }} .ch-content-box {
      max-width: 100%;
    }

    #CustomHero-{{ section.id }} .ch-content-box__heading {
      font-size: 30px;
      line-height: 1;
      margin-bottom: 12px;
    }

    #CustomHero-{{ section.id }} .ch-content-box__desc {
      font-size: 16px;
      line-height: 1.35;
      margin-bottom: 24px;
      max-width: 100%;
    }

    #CustomHero-{{ section.id }} .ch-btn--hero {
      width: 100%;
      max-width: 240px;
      height: 45px;
    }

    #CustomHero-{{ section.id }} .ch-announcement__text {
      font-size: 14px;
      letter-spacing: 0.02em;
    }
  }
{%- endstyle -%}

<section id="CustomHero-{{ section.id }}" class="custom-hero-banner" {{ section.shopify_attributes }}>
  {%- if section.settings.enable_top_bar -%}
    <header class="ch-top-bar">
      <div class="ch-top-bar__inner">
        {%- comment -%} Mobile Hamburger Toggle {%- endcomment -%}
        <button
          type="button"
          class="ch-mobile-toggle"
          aria-expanded="false"
          aria-controls="ChMobileDrawer-{{ section.id }}"
          aria-label="Toggle navigation menu"
        >
          <span class="ch-hamburger-icon">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>

        {%- comment -%} Brand Logo {%- endcomment -%}
        <a href="{{ routes.root_url }}" class="ch-brand-logo" aria-label="{{ shop.name }}">
          {%- if section.settings.logo_image != blank -%}
            <img
              src="{{ section.settings.logo_image | image_url: width: 300 }}"
              alt="{{ section.settings.logo_image.alt | default: shop.name | escape }}"
              class="ch-brand-logo__img"
              width="152"
              height="20"
              loading="eager"
            >
          {%- else -%}
            {%- comment -%} Fallback to Figma Vector Logo SVG if available, or text {%- endcomment -%}
            <img
              src="{{ 'tisso-vison-logo.svg' | asset_url }}"
              alt="{{ section.settings.logo_text | default: 'TISSO VISON' | escape }}"
              class="ch-brand-logo__img"
              width="152"
              height="20"
              loading="eager"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
            >
            <span class="ch-brand-logo__text" style="display: none;">{{ section.settings.logo_text | default: 'TISSO VISON' }}</span>
          {%- endif -%}
        </a>

        {%- comment -%} Tagline (Desktop) {%- endcomment -%}
        {%- if section.settings.top_bar_tagline != blank -%}
          <p class="ch-top-bar__tagline">
            {{ section.settings.top_bar_tagline }}
          </p>
        {%- endif -%}

        {%- comment -%} CTA Button (Desktop) {%- endcomment -%}
        {%- if section.settings.top_bar_btn_label != blank -%}
          <div class="ch-top-bar__cta">
            <a href="{{ section.settings.top_bar_btn_link | default: routes.all_products_collection_url }}" class="ch-btn ch-btn--top-bar">
              <span>{{ section.settings.top_bar_btn_label }}</span>
              <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M0 6H24M24 6L19 1M24 6L19 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Collapsible Drawer (Mobile) {%- endcomment -%}
      <div id="ChMobileDrawer-{{ section.id }}" class="ch-mobile-drawer" aria-hidden="true">
        <div class="ch-mobile-drawer__content">
          {%- if section.settings.top_bar_tagline != blank -%}
            <p class="ch-mobile-drawer__tagline">{{ section.settings.top_bar_tagline }}</p>
          {%- endif -%}
          {%- if section.settings.top_bar_btn_label != blank -%}
            <a href="{{ section.settings.top_bar_btn_link | default: routes.all_products_collection_url }}" class="ch-btn ch-btn--top-bar" style="width: 100%; max-width: 280px;">
              <span>{{ section.settings.top_bar_btn_label }}</span>
              <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M0 6H24M24 6L19 1M24 6L19 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    </header>
  {%- endif -%}

  {%- comment -%}
    Main Hero Section
  {%- endcomment -%}
  <div class="ch-main-hero">
    {%- comment -%} Background line art illustration / image {%- endcomment -%}
    <div class="ch-main-hero__artwork" aria-hidden="true">
      {%- comment -%} Desktop illustration {%- endcomment -%}
      {%- if section.settings.desktop_image != blank -%}
        <img
          src="{{ section.settings.desktop_image | image_url: width: 2880 }}"
          alt="{{ section.settings.desktop_image.alt | default: section.settings.heading | escape }}"
          class="ch-main-hero__artwork-img ch-main-hero__artwork-desktop"
          loading="eager"
          width="1440"
          height="780"
        >
      {%- else -%}
        <img
          src="{{ 'hero-illustration-desktop.svg' | asset_url }}"
          alt=""
          class="ch-main-hero__artwork-img ch-main-hero__artwork-desktop"
          loading="eager"
          width="1440"
          height="780"
        >
      {%- endif -%}

      {%- comment -%} Mobile illustration {%- endcomment -%}
      {%- if section.settings.mobile_image != blank -%}
        <img
          src="{{ section.settings.mobile_image | image_url: width: 750 }}"
          alt="{{ section.settings.mobile_image.alt | default: section.settings.heading | escape }}"
          class="ch-main-hero__artwork-img ch-main-hero__artwork-mobile"
          loading="eager"
          width="686"
          height="264"
        >
      {%- elsif section.settings.desktop_image != blank -%}
        <img
          src="{{ section.settings.desktop_image | image_url: width: 750 }}"
          alt="{{ section.settings.desktop_image.alt | default: section.settings.heading | escape }}"
          class="ch-main-hero__artwork-img ch-main-hero__artwork-mobile"
          loading="eager"
          width="686"
          height="264"
        >
      {%- else -%}
        <img
          src="{{ 'hero-illustration-mobile.svg' | asset_url }}"
          alt=""
          class="ch-main-hero__artwork-img ch-main-hero__artwork-mobile"
          loading="eager"
          width="686"
          height="264"
        >
      {%- endif -%}
    </div>

    {%- comment -%} Content Box (Bottom-Left on Desktop, Stacked on Mobile) {%- endcomment -%}
    <div class="ch-main-hero__container">
      <div class="ch-content-box">
        {%- if section.settings.heading != blank -%}
          <h1 class="ch-content-box__heading">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="ch-content-box__desc">
            {{ section.settings.description }}
          </p>
        {%- endif -%}

        {%- if section.settings.hero_btn_label != blank -%}
          <a href="{{ section.settings.hero_btn_link | default: routes.all_products_collection_url }}" class="ch-btn ch-btn--hero">
            <span>{{ section.settings.hero_btn_label }}</span>
            <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M0 6H24M24 6L19 1M24 6L19 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%}
    Bottom Announcement Strip
  {%- endcomment -%}
  {%- if section.settings.enable_announcement and section.settings.announcement_text != blank -%}
    <aside class="ch-announcement" aria-label="Announcement">
      <p class="ch-announcement__text">
        {{ section.settings.announcement_text }}
      </p>
    </aside>
  {%- endif -%}
</section>

<script>
  (function() {
    // Pure Vanilla JS for Mobile Navigation Drawer Toggle
    const sectionEl = document.getElementById('CustomHero-{{ section.id }}');
    if (!sectionEl) return;

    const toggleBtn = sectionEl.querySelector('.ch-mobile-toggle');
    const drawer = sectionEl.querySelector('.ch-mobile-drawer');

    if (!toggleBtn || !drawer) return;

    function toggleMenu(isOpen) {
      const willOpen = typeof isOpen === 'boolean' ? isOpen : toggleBtn.getAttribute('aria-expanded') !== 'true';
      toggleBtn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      drawer.setAttribute('aria-hidden', willOpen ? 'false' : 'true');
      drawer.classList.toggle('is-open', willOpen);
    }

    toggleBtn.addEventListener('click', function(e) {
      e.preventDefault();
      toggleMenu();
    });

    // Close on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleMenu(false);
        toggleBtn.focus();
      }
    });

    // Close on click outside
    document.addEventListener('click', function(e) {
      if (!sectionEl.contains(e.target) && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleMenu(false);
      }
    });
  })();
</script>

