{%- doc -%}
  Adds the global bonus product when a cart line has the exact option values
  Color: Black and Size: M or Medium. No other variant is used as a fallback.

  This is the fallback path for cart additions that bypass the product grid.
  The grid section owns its own merchant-selectable bonus product.
{%- enddoc -%}

{%- liquid
  assign bonus_product = all_products['dark-winter-jacket']
  assign bonus_variant = nil

  for variant in bonus_product.variants
    if variant.available
      assign variant_color = ''
      assign variant_size = ''

      for option in variant.options_with_values
        assign option_name = option.name | downcase | strip
        assign option_value = option.value | downcase | strip

        if option_name == 'color' or option_name == 'colour'
          assign variant_color = option_value
        elsif option_name == 'size'
          assign variant_size = option_value
        endif
      endfor

      if variant_color == 'black'
        if variant_size == 'm' or variant_size == 'medium'
          assign bonus_variant = variant
          break
        endif
      endif
    endif
  endfor
-%}

{%- if bonus_variant != blank and bonus_variant.available -%}
  <script type="module">
    import { StandardEvents, CartLinesUpdateEvent } from '@shopify/events';

    const BONUS_VARIANT_ID = {{ bonus_variant.id }};
    const BONUS_PRODUCT_ID = {{ bonus_product.id }};
    let isAutoAdding = false;

    function isBlackAndMediumItem(item) {
      if (!item) return false;
      if (Number(item.product_id) === BONUS_PRODUCT_ID) return false;

      const options = Array.isArray(item.options_with_values) ? item.options_with_values : [];
      let color = '';
      let size = '';

      for (const option of options) {
        const name = String(option?.name || '').trim().toLowerCase();
        const value = String(option?.value || '').trim().toLowerCase();

        if (name === 'color' || name === 'colour') color = value;
        if (name === 'size') size = value;
      }

      return color === 'black' && (size === 'm' || size === 'medium');
    }

    async function fetchRawCart() {
      try {
        const response = await fetch('/cart.js', {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
        });
        return response.ok ? await response.json() : null;
      } catch {
        return null;
      }
    }

    function getCartSectionIds() {
      const sectionIds = new Set();

      for (const component of document.querySelectorAll('cart-items-component[data-section-id]')) {
        const sectionId = component.dataset.sectionId;
        if (sectionId) sectionIds.add(sectionId);
      }

      return [...sectionIds];
    }

    async function checkAndAddBonus(cart) {
      if (isAutoAdding) return;

      // Event promises resolve with a CartSummary (cart.lines), while option
      // values only exist on the raw AJAX cart (cart.items). Normalize here.
      const currentCart = Array.isArray(cart?.items) ? cart : await fetchRawCart();
      if (!currentCart || !Array.isArray(currentCart.items)) return;

      const hasTriggerItem = currentCart.items.some(isBlackAndMediumItem);
      const hasBonus = currentCart.items.some((item) => Number(item.id) === BONUS_VARIANT_ID);

      if (hasTriggerItem && !hasBonus) {
        isAutoAdding = true;
        try {
          const sectionIds = getCartSectionIds();
          const sectionParams = new URLSearchParams();
          // Render the cart sections in the same response as the bonus add so
          // consumers can update the drawer without morphing a pre-bonus snapshot.
          sectionParams.set('sections', sectionIds.join(','));
          sectionParams.set('sections_url', window.location.pathname);

          const addUrl = sectionIds.length ? `/cart/add.js?${sectionParams}` : '/cart/add.js';

          const res = await fetch(addUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify({
              items: [{ id: BONUS_VARIANT_ID, quantity: 1 }],
            }),
          });

          if (res.ok) {
            const bonusResponse = await res.json().catch(() => null);
            const sections = bonusResponse?.sections ?? null;
            const updatedCartRes = await fetch('/cart.js', {
              headers: { Accept: 'application/json' },
              cache: 'no-store',
            });
            if (updatedCartRes.ok) {
              const updatedCart = await updatedCartRes.json();
              const updatedCartSummary = CartLinesUpdateEvent.createCartFromAjaxResponse(updatedCart);
              const deferred = CartLinesUpdateEvent.createPromise();

              document.dispatchEvent(
                new CartLinesUpdateEvent({
                  action: 'add',
                  context: 'cart',
                  cart: updatedCartSummary,
                  lines: [{ merchandiseId: String(BONUS_VARIANT_ID), quantity: 1 }],
                  promise: deferred.promise,
                  detail: { source: 'auto-add-bonus', itemCount: updatedCart.item_count },
                })
              );

              deferred.resolve({
                cart: updatedCartSummary,
                detail: { source: 'auto-add-bonus', itemCount: updatedCart.item_count, sections },
              });
            }
          }
        } catch (e) {
          console.warn('[auto-add-bonus] Failed to auto-add bonus product:', e);
        } finally {
          isAutoAdding = false;
        }
      }
    }

    // Standard cart events cover theme-driven additions; the promise settles
    // with the cart summary that consumers already use.
    document.addEventListener(StandardEvents.cartLinesUpdate, async (event) => {
      if (event.action !== 'add') return;
      if (event.detail?.source === 'auto-add-bonus') return;

      if (event.promise && typeof event.promise.then === 'function') {
        try {
          const result = await event.promise;
          if (result?.cart) {
            await checkAndAddBonus(result.cart);
          }
        } catch {}
      }
    });

    // Direct /cart/add.js callers do not emit a standard event, so observe the
    // response and reconcile against the raw cart.
    const originalFetch = window.fetch;
    window.fetch = async function (...args) {
      const response = await originalFetch.apply(this, args);
      try {
        const url = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url) || '';
        if (url.includes('/cart/add')) {
          const clone = response.clone();
          const data = await clone.json().catch(() => null);
          if (data && !data.status) {
            const cartRes = await originalFetch('/cart.js', {
              headers: { Accept: 'application/json' },
              cache: 'no-store',
            });
            if (cartRes.ok) {
              const cart = await cartRes.json();
              await checkAndAddBonus(cart);
            }
          }
        }
      } catch {}
      return response;
    };
  </script>
{%- endif -%}
